<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- I3: a studied backup too large to buffer is imported as questions only.
         The learner is told plainly that progress was skipped, not silently left
         behind. -->
    <string name="r2_import_progress_skipped_notice">This backup is too large to restore review progress. Your questions were imported, but their progress was skipped.</string>

    <!-- I6: display forms of the data-layer fallback tokens. The persisted token
         values ("Category", "Passage", "Cloze card from Anki.") never change —
         only what the learner reads is localized here. -->
    <string name="r2_import_fallback_category">Category</string>
    <string name="r2_import_fallback_passage">Passage</string>
    <string name="r2_import_fallback_cloze_explanation">Cloze card from Anki.</string>

    <!-- Import preview badges. A zero-option question is a flashcard; CHANGED
         and DUPLICATE describe how the row meets the existing bank. A card can
         be either, so a row may show two. -->
    <string name="r2_import_badge_flashcard">FLASHCARD</string>
    <string name="r2_import_badge_changed">CHANGED</string>
    <string name="r2_import_badge_duplicate">DUPLICATE</string>
    <!-- A card's back in the preview is its answer, not an explanation
         (mirrors the editor, Study and Browse). %1$s is the back text. -->
    <string name="r2_import_answer_label">Answer: %1$s</string>
</resources>
