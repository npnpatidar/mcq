<?xml version="1.0" encoding="utf-8"?>
<!--
  Round-2 Browse/Search fixes: user-facing copy that used to be an English
  literal in a Composable or in QuestionSearch.Scope. All names are prefixed
  r2_browse_ so they cannot collide with the existing, translated string files.
  Counts use plurals; placeholders match across locales.
-->
<resources>
    <string name="r2_browse_selected">Selected</string>
    <plurals name="r2_browse_question_count">
        <item quantity="one">(%1$d question)</item>
        <item quantity="other">(%1$d questions)</item>
    </plurals>

    <!-- Browse filter chips -->
    <string name="r2_browse_filter_all">All</string>
    <!-- "No answer" meant "no answer key"; a flashcard has none by design, so
         the chip names the shape it is really about and excludes cards. -->
    <string name="r2_browse_filter_no_answer">No answer key (multiple choice)</string>
    <string name="r2_browse_filter_no_explanation">No explanation</string>

    <!-- Search -->
    <string name="r2_browse_blank_text">(blank text)</string>
    <string name="r2_browse_scope_all">All</string>
    <string name="r2_browse_scope_questions">Questions</string>
    <string name="r2_browse_scope_options">Options</string>
    <string name="r2_browse_open_question">Open question</string>
    <!-- A result whose only match is in the back shows this short snippet, so
         the row explains why it matched. The label follows the app's split: a
         card's back is its Answer, a multiple-choice question's is its
         Explanation. %1$s is the snippet. -->
    <string name="r2_browse_answer_snippet">Answer: %1$s</string>
    <string name="r2_browse_explanation_snippet">Explanation: %1$s</string>

    <!-- Cross-paper move: collision disclosure (warning + honest toast) -->
    <string name="r2_browse_move_collision_warning">If the destination paper already has a card for a question, that card and its own review history are kept, and the source paper\'s history for that question is discarded.</string>
    <string name="r2_browse_move_collision_toast">Any source history that collided with an existing destination card was discarded.</string>

    <!-- Accessibility labels -->
    <string name="r2_browse_select_question">Select question %1$d</string>
    <string name="r2_browse_correct_option">Correct answer</string>
    <string name="r2_browse_other_option">Not the correct answer</string>
</resources>
