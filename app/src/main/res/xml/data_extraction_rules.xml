<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules.

  The database holds every question bank, bookmark and per-attempt history,
  and the log directory holds diagnostic output. Neither belongs in cloud
  backup or a device-to-device transfer: the user has an explicit JSON backup
  and Anki export for moving content deliberately.

  Shared preferences are small settings (font scale, scheduler config) and are
  kept so a restored device looks familiar.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="log" />
        <exclude domain="file" />
        <exclude domain="external" />
        <include domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="log" />
        <exclude domain="file" />
        <exclude domain="external" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
