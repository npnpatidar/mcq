<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 equivalent of data_extraction_rules.xml. Same reasoning:
     the question banks and logs stay out of cloud backup. -->
<full-backup-content>
    <exclude domain="database" />
    <exclude domain="log" />
    <exclude domain="file" />
    <exclude domain="external" />
    <include domain="sharedpref" />
</full-backup-content>
