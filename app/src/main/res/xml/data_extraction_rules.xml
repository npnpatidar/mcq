<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules.

  The database holds every question bank, bookmark and per-attempt history.
  It must not go to cloud backup or a device-to-device transfer: the user has
  an explicit JSON backup and Anki export for moving content deliberately.

  Settings (theme, language, scheduler) live in Preferences DataStore under
  files/datastore/settings.preferences_pb, not in shared preferences. That one
  file is included explicitly in both transports so a restored device keeps
  those choices; shared preferences only hold a tiny language mirror and a
  transient import journal.

  An <include> is an allow-list: once one is present Android backs up only the
  matched files. Everything else — including the diagnostic logs — stays out
  of both transports by default, so no path-scoped logs exclude is needed (and
  lint rejects an exclude whose path is not inside an included path).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" />
        <exclude domain="log" />
        <exclude domain="external" />
        <include domain="sharedpref" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="log" />
        <exclude domain="external" />
        <include domain="sharedpref" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
